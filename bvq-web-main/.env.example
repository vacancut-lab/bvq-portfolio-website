# Biến môi trường — copy sang Vercel > Settings > Environment Variables
# Đừng commit file .env thật. File này chỉ ví dụ.

# Telegram (lấy từ @BotFather — giữ kín)
TELEGRAM_BOT_TOKEN=YOUR_TOKEN_HERE
TELEGRAM_CHAT_ID=  # sẽ điền sau khi bạn chat với bot

# Email người nhận
LEAD_TO_EMAIL=vacancut@gmail.com
LEAD_FROM_EMAIL=BVQ Lead <onboarding@resend.dev>

# Tùy chọn — Resend để gửi email (https://resend.com/api-keys)
RESEND_API_KEY=
